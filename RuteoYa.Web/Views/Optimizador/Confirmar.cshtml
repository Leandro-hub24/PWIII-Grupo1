@model RuteoYa.Web.Models.ConfirmarSeleccionViewModel
@{
    ViewData["Title"] = "Confirmar selección";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Confirmar selección</h2>
    <p class="text-muted mb-0">Revisá el resumen antes de reservar.</p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorConflicto))
{
    <div class="alert alert-danger mb-4">
        @Model.ErrorConflicto
    </div>
}

<div class="ry-card mb-4">
    <h4 class="fw-bold mb-3">@Model.TramoViaje</h4>

    @for (int i = 0; i < Model.Envios.Count; i++)
    {
        var envio = Model.Envios[i];
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-3 @(i > 0 ? "border-top" : "")"
             style="border-color: var(--ln) !important;">
            <div>
                <b>@envio.Origen → @envio.Destino</b>
            </div>
            <span class="text-muted">@envio.PesoKg kg · @envio.DesvioKm km</span>
            <b class="text-success">$@envio.Pago.ToString("N0")</b>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="ry-card ry-card-green h-100">
            <p class="mb-1" style="font-size: 13px;">Ganancia total</p>
            <div class="ry-stat-number">$@Model.GananciaTotal.ToString("N0")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ry-card h-100">
            <span class="ry-label d-block mb-1">Peso total</span>
            <div class="ry-stat-number">@Model.PesoTotalKg kg</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ry-card h-100">
            <span class="ry-label d-block mb-1">Desvío total</span>
            <div class="ry-stat-number">@Model.DesvioTotalKm km</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ry-card h-100">
            <span class="ry-label d-block mb-1">Paquetes</span>
            <div class="ry-stat-number">@Model.CantidadPaquetes</div>
        </div>
    </div>
</div>

<form asp-action="Reservar" method="post">
    <input type="hidden" name="viajeId" value="@Model.ViajeId" />

    @* Binding indexado seguro para listas en ASP.NET Core *@
    @for (int i = 0; i < Model.Envios.Count; i++)
    {
        <input type="hidden" name="envioIds[@i]" value="@Model.Envios[i].EnvioId" />
    }

    <div class="d-flex gap-3 flex-wrap">
        <a class="btn btn-ry-outline" asp-action="Index" asp-route-viajeId="@Model.ViajeId">Volver</a>
        <button type="submit" class="btn btn-ry-primary">Confirmar y reservar</button>
    </div>
</form>