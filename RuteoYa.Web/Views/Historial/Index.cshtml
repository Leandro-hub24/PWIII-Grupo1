
@model List<RuteoYa.Entidades.DTOs.TransporteDto>

@{
    ViewData["Title"] = "Historial";
}

<div class="container py-4">

    <h2>Historial de transportes</h2>
    <p class="text-muted">Consultá tus transportes entregados y las ganancias obtenidas.</p>

    <form method="get" asp-controller="Historial" asp-action="Index"
          class="row g-3 align-items-end mb-4">

        <div class="col-md-4">
            <label class="form-label">Desde</label>
            <input type="date" name="desde" class="form-control"
                   value="@ViewBag.Desde" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Hasta</label>
            <input type="date" name="hasta" class="form-control"
                   value="@ViewBag.Hasta" />
        </div>

        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-controller="Historial" asp-action="Index"
               class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card p-3">
                <span class="text-muted">Transportes entregados</span>
                <h3>@Model.Count</h3>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-3">
                <span class="text-muted">Ganancia total</span>
                <h3>$@(((decimal)ViewBag.GananciaTotal).ToString("N2"))</h3>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Ganancia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transporte in Model)
                    {
                        <tr>
                            <td>@transporte.FechaViaje.ToString("dd/MM/yyyy")</td>
                            <td>@transporte.OrigenDir</td>
                            <td>@transporte.DestinoDir</td>
                            <td>@transporte.Descripcion</td>
                            <td>@transporte.EstadoNombre</td>
                            <td>$@transporte.Ganancia.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Todavía no tenés transportes entregados para mostrar.
        </div>
    }

</div>
