@using RuteoYa.Web.Models
@model RuteoYa.Entidades.DTOs.ViajeDto
@{
    ViewData["Title"] = "Detalle del viaje";
}

<a asp-action="Index" class="text-decoration-none small">← Volver a mis viajes</a>

<div class="d-flex justify-content-between align-items-center mt-2 mb-3">
    <h2 class="font-space fw-bold mb-0">@Model.OrigenDir → @Model.DestinoDir</h2>
    @if (Model.Activo)
    {
        <span class="ry-badge ry-badge-success">Activo</span>
    }
    else
    {
        <span class="ry-badge ry-badge-danger">Inactivo</span>
    }
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="ry-card p-4 mb-3">
            <h5 class="fw-bold mb-3">Datos del viaje</h5>
            <dl class="row mb-0">
                <dt class="col-sm-5">Origen</dt><dd class="col-sm-7">@Model.OrigenDir</dd>
                <dt class="col-sm-5">Destino</dt><dd class="col-sm-7">@Model.DestinoDir</dd>
                <dt class="col-sm-5">Días</dt><dd class="col-sm-7">@Dias.Texto(Model.Dias)</dd>
                <dt class="col-sm-5">Horario</dt><dd class="col-sm-7">@Model.HoraSalida.ToString("HH:mm") a @Model.HoraLlegada.ToString("HH:mm")</dd>
                <dt class="col-sm-5">Capacidad</dt><dd class="col-sm-7">@Model.MaxPaquetes paquetes</dd>
                <dt class="col-sm-5">Peso máximo</dt><dd class="col-sm-7">@Model.PesoMaxKg kg</dd>
                <dt class="col-sm-5">Desvío máximo</dt><dd class="col-sm-7">@Model.DesvioMaxKm km</dd>
                <dt class="col-sm-5">Distancia</dt><dd class="col-sm-7">@Model.DistanciaKm km</dd>
            </dl>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-ry-primary">Editar</a>
                @if (Model.Activo)
                {
                    <a asp-controller="Oportunidades" asp-action="Index" asp-route-viajeId="@Model.Id" class="btn btn-ry-outline">Ver oportunidades</a>
                    <form asp-action="Desactivar" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" name="volverA" value="detalle" />
                        <button type="submit" class="btn btn-outline-danger">Desactivar</button>
                    </form>
                }
                else
                {
                    <form asp-action="Activar" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" name="volverA" value="detalle" />
                        <button type="submit" class="btn btn-outline-success">Activar</button>
                    </form>
                }
            </div>
        </div>

        <div class="ry-card p-4">
            <h5 class="fw-bold mb-3">Recorrido</h5>
            <ol class="mb-0">
                <li>@Model.OrigenDir</li>
                @foreach (var parada in Model.Paradas)
                {
                    <li>@parada.Direccion</li>
                }
                <li>@Model.DestinoDir</li>
            </ol>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="ry-card p-4">
            <h5 class="fw-bold mb-3">Paquetes asignados</h5>
            @if (Model.PaquetesAsignados.Count == 0)
            {
                <p class="text-muted mb-0">Todavía no aceptaste ningún envío para este viaje.</p>
            }
            else
            {
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Paquete</th>
                            <th>Pago</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var paquete in Model.PaquetesAsignados)
                        {
                            <tr>
                                <td>@paquete.FechaViaje.ToString("dd/MM/yyyy")</td>
                                <td>@paquete.Descripcion (@paquete.PesoKg kg)</td>
                                <td>$@paquete.Monto.ToString("N0")</td>
                                <td>@paquete.Estado</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
