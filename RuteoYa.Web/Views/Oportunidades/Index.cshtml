@model RuteoYa.Entidades.DTOs.PaginadoOportunidadesDto<RuteoYa.Entidades.Entities.Envio>
@{
    int viajeId = ViewBag.ViajeId ?? 1;
    string orden = ViewBag.OrdenActual ?? "ganancia";
    ViewData["Title"] = "Oportunidades";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Oportunidades</h2>
            <p class="text-muted">Envíos compatibles con tu viaje seleccionado.</p>
        </div>
    </div>

    <!-- Filtros de Orden -->
    <div class="d-flex align-items-center mb-4">
        <span class="me-3 font-weight-bold">Ordenar por</span>
        <a asp-action="Index" asp-route-viajeId="@viajeId" asp-route-orden="ganancia"
           class="btn btn-sm me-2 @(orden == "ganancia" ? "btn-dark" : "btn-outline-secondary")">Ganancia</a>
        <a asp-action="Index" asp-route-viajeId="@viajeId" asp-route-orden="desvio"
           class="btn btn-sm me-2 @(orden == "desvio" ? "btn-dark" : "btn-outline-secondary")">Desvío</a>
        <a asp-action="Index" asp-route-viajeId="@viajeId" asp-route-orden="compatibilidad"
           class="btn btn-sm @(orden == "compatibilidad" ? "btn-dark" : "btn-outline-secondary")">Compatibilidad</a>
    </div>

    <!-- Tarjetas de Oportunidades -->
    <div class="row">
        @if (!Model.Items.Any())
        {
            <div class="alert alert-info">No se encontraron envíos compatibles para este viaje.</div>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <div class="card mb-3 shadow-sm border-0 rounded-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1 font-weight-bold">@item.OrigenDir → @item.DestinoDir</h5>
                            <small class="text-muted">@item.PesoKg kg</small>
                        </div>
                        <div>
                            <span class="badge bg-success me-3">Compatible</span>
                            <span class="h4 font-weight-bold text-success me-4">$@item.Monto.ToString("N0")</span>

                            <a asp-action="Detalle" asp-route-id="@item.Id" asp-route-viajeId="@viajeId" class="btn btn-outline-secondary me-2">Ver detalle</a>

                            <form asp-action="AceptarEnvio" method="post" class="d-inline">
                                <input type="hidden" name="envioId" value="@item.Id" />
                                <input type="hidden" name="viajeId" value="@viajeId" />
                                <button type="submit" class="btn btn-dark">Aceptar</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    @if (Model.TotalDePaginas > 1)
    {
        // Ventana de números: muestra la actual y 2 hacia cada lado
        int desde = Math.Max(1, Model.PaginaActual - 2);
        int hasta = Math.Min(Model.TotalDePaginas, Model.PaginaActual + 2);

        <nav aria-label="Paginación de oportunidades" class="mt-4">
            <div class="d-flex justify-content-center align-items-center flex-wrap gap-2">

                <a class="btn btn-outline-dark rounded-pill px-3 @(Model.PaginaActual <= 1 ? "disabled" : "")"
                   asp-action="Index" asp-route-viajeId="@viajeId" asp-route-orden="@orden"
                   asp-route-paginaActual="@(Model.PaginaActual - 1)">‹ Anterior</a>

                @if (desde > 1)
                {
                    <a class="btn btn-outline-dark rounded-pill"
                       asp-action="Index" asp-route-viajeId="@viajeId" asp-route-orden="@orden"
                       asp-route-paginaActual="1">1</a>

                    @if (desde > 2)
                    {
                        <span class="px-1 text-muted">…</span>
                    }
                }

                @for (int i = desde; i <= hasta; i++)
                {
                    <a class="btn rounded-pill @(i == Model.PaginaActual ? "btn-dark shadow" : "btn-outline-dark")"
                       asp-action="Index" asp-route-viajeId="@viajeId" asp-route-orden="@orden"
                       asp-route-paginaActual="@i">@i</a>
                }

                @if (hasta < Model.TotalDePaginas)
                {
                    @if (hasta < Model.TotalDePaginas - 1)
                    {
                        <span class="px-1 text-muted">…</span>
                    }

                    <a class="btn btn-outline-dark rounded-pill"
                       asp-action="Index" asp-route-viajeId="@viajeId" asp-route-orden="@orden"
                       asp-route-paginaActual="@Model.TotalDePaginas">@Model.TotalDePaginas</a>
                }

                <a class="btn btn-outline-dark rounded-pill px-3 @(Model.PaginaActual >= Model.TotalDePaginas ? "disabled" : "")"
                   asp-action="Index" asp-route-viajeId="@viajeId" asp-route-orden="@orden"
                   asp-route-paginaActual="@(Model.PaginaActual + 1)">Siguiente ›</a>
            </div>

            <p class="text-center text-muted small mt-2 mb-0">
                Página @Model.PaginaActual de @Model.TotalDePaginas · @Model.TotalDeItems envíos
            </p>
        </nav>
    }
</div>
