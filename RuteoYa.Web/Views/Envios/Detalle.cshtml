@using RuteoYa.Entidades.Common.Enums
@model RuteoYa.Entidades.DTOs.EnvioDto
@{
    ViewData["Title"] = "Detalle del envío";
    var tamano = Model.Tamano switch
    {
        TamanoEnvio.Pequeno => "Pequeño",
        TamanoEnvio.Mediano => "Mediano",
        _ => "Grande"
    };
}

<a asp-action="Index" class="text-decoration-none small">← Volver a mis envíos</a>

<div class="d-flex justify-content-between align-items-center mt-2 mb-3">
    <h2 class="font-space fw-bold mb-0">@Model.OrigenDir → @Model.DestinoDir</h2>
    <partial name="_EstadoEnvioBadge" model="Model.Estado" />
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="ry-card p-4 h-100">
            <h5 class="fw-bold mb-3">Datos del paquete</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">Fecha</dt><dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-4">Peso</dt><dd class="col-sm-8">@Model.PesoKg kg</dd>
                <dt class="col-sm-4">Tamaño</dt><dd class="col-sm-8">@tamano</dd>
                <dt class="col-sm-4">Monto ofrecido</dt><dd class="col-sm-8">$@Model.Monto.ToString("N0")</dd>
                <dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@Model.Descripcion</dd>
                <dt class="col-sm-4">Publicado</dt><dd class="col-sm-8">@Model.CreadoEn.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>

            @if (Model.SePuedeCancelar)
            {
                <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="mt-4"
                      onsubmit="return confirm('¿Seguro que querés cancelar este envío?');">
                    <button type="submit" class="btn btn-outline-danger">Cancelar envío</button>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="ry-card p-4 mb-3">
            <h5 class="fw-bold mb-3">Viaje asociado</h5>
            @if (Model.ViajeId == null)
            {
                <p class="text-muted mb-0">Todavía ningún conductor tomó este envío.</p>
            }
            else
            {
                <p class="mb-1">Viaje #@Model.ViajeId desde @Model.ViajeOrigen</p>
                <p class="text-muted mb-0">Fecha del viaje: @Model.FechaViaje?.ToString("dd/MM/yyyy")</p>
            }
        </div>

        <div class="ry-card p-4">
            <h5 class="fw-bold mb-3">Historial de estados</h5>
            @if (!Model.Historial.Any())
            {
                <p class="text-muted mb-0">Sin cambios de estado todavía.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var h in Model.Historial)
                    {
                        <li class="mb-2">
                            <span class="small text-muted">@h.Fecha.ToString("dd/MM/yyyy HH:mm")</span><br />
                            @h.EstadoAnterior → <strong>@h.EstadoNuevo</strong>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
