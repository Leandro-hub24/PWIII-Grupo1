@model RuteoYa.Web.Models.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Crear cuenta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RuteaYa</title>

    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body style="background-color: var(--bg); margin: 0; padding: 0;">

    <div class="container-fluid p-0">
        <div class="row g-0 min-vh-100">

            <!-- Banner Izquierdo -->
            <div class="col-lg-6 d-none d-lg-flex ry-auth-left">
                <div class="brand fs-4 fw-bold font-space">RuteaYa</div>
                <div>
                    <h1 class="fw-bold font-space">Convertí tus viajes habituales en una oportunidad.</h1>
                    <p>Compartí el espacio libre de tus recorridos y ganá dinero llevando paquetes.</p>
                </div>
                <div></div>
            </div>

            <!-- Formulario Derecho -->
            <div class="col-12 col-lg-6 ry-auth-right">
                <div class="ry-auth-form">
                    <h1 class="fw-bold mb-4 font-space">Crear cuenta</h1>

                    <form asp-controller="Usuarios" asp-action="Create" method="post">

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label asp-for="Nombre" class="form-label fw-semibold small">Nombre</label>
                                <input asp-for="Nombre" class="form-control ry-input" placeholder="Tu nombre" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Apellido" class="form-label fw-semibold small">Apellido</label>
                                <input asp-for="Apellido" class="form-control ry-input" placeholder="Tu apellido" />
                                <span asp-validation-for="Apellido" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small">Email</label>
                            <input asp-for="Email" class="form-control ry-input" placeholder="tu@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PasswordHash" class="form-label fw-semibold small">Contraseña</label>
                            <div class="input-group">
                                <input asp-for="PasswordHash" type="password" class="form-control ry-input border-end-0" id="passwordHashInput" placeholder="••••••••" />
                                <button class="btn btn-outline-secondary border-start-0 bg-transparent text-secondary" type="button" onclick="togglePassword('passwordHashInput', 'iconPassword1')">
                                    <i class="bi bi-eye" id="iconPassword1"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PasswordConfirmed" class="form-label fw-semibold small">Repetir contraseña</label>
                            <div class="input-group">
                                <input asp-for="PasswordConfirmed" type="password" class="form-control ry-input border-end-0" id="passwordConfirmedInput" placeholder="••••••••" />
                                <button class="btn btn-outline-secondary border-start-0 bg-transparent text-secondary" type="button" onclick="togglePassword('passwordConfirmedInput', 'iconPassword2')">
                                    <i class="bi bi-eye" id="iconPassword2"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PasswordConfirmed" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-ry-primary w-100 py-2 mb-3">Registrarse</button>

                        <div class="text-center">
                            <span class="text-secondary small">¿Ya tenés una cuenta? </span>
                            <a asp-controller="Auth" asp-action="Login" class="text-white fw-semibold small text-decoration-underline">Ingresar</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</body>
<script>
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");
        }
    }
</script>
</html>